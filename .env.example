# Supabase project settings → API. The anon/publishable key is safe to expose;
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paid readings (leave unset until Razorpay is live). See README "Paid readings".
# VITE_PAYWALL=on
# VITE_BUSINESS_NAME=Your legal or trade name
# VITE_CONTACT_EMAIL=support@example.com
# VITE_CONTACT_ADDRESS=City, State, India
